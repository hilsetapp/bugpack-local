{
  "manifest_version": 3,
  "name": "Bugpack Local",
  "short_name": "Bugpack",
  "version": "0.1.2",
  "minimum_chrome_version": "116",
  "description": "Capture browser bugs into local, reviewable .bugpack files.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads", "desktopCapture", "offscreen"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bugpack Local",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_popup": "src/popup.html"
  },
  "commands": {
    "capture-bug": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Create a bug report from the current capture"
    }
  }
}
